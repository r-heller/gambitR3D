  "decisions": [
    {"id": "D01", "topic": "Board identity", "origin": "supplied_concept", "path": "main_boards, platforms", "rationale": "Three fixed 4x4 boards and four movable 2x2 platforms give 64 physical squares. A square keeps its id board:u:v for the whole game; projected file and rank are derived from the board's current position."},
    {"id": "D02", "topic": "Main-board placement", "origin": "supplied_concept", "path": "main_boards", "rationale": "W covers b-e/1-4, N covers b-e/3-6 and B covers b-e/5-8, so W/N and N/B share eight projected coordinates each while every physical square stays distinct."},
    {"id": "D03", "topic": "Dock geometry", "origin": "proposed_resolution", "path": "docks", "rationale": "Each main board has four corner pins. A platform at a left pin covers files a-b, at a right pin e-f; at a low pin it starts one rank below the board, at a high pin three ranks above the board's first rank."},
    {"id": "D04", "topic": "Dock adjacency", "origin": "proposed_resolution", "path": "dock_adjacency", "rationale": "Inferred graph: on one board, the other corner on the same pin rank or file; between W-N and N-B, same-side pins at most two ranks apart; never W-B directly. It matches the illustrated five destinations from a middle low dock and three from an outer rear dock, but those examples do not prove every edge."},
    {"id": "D05", "topic": "Platform eligibility", "origin": "proposed_resolution", "path": "platform_actions.occupants_required", "rationale": "A platform moves only when it carries exactly one piece and that piece belongs to the mover. Empty, enemy-controlled and crowded platforms stay put; the four-piece starting platforms cannot move."},
    {"id": "D06", "topic": "Rotation", "origin": "proposed_resolution", "path": "platform_actions.rotation_choices", "rationale": "Relocation keeps the orientation or turns it by 180 degrees; both are distinct actions. Turning in place without relocation is not an action."},
    {"id": "D07", "topic": "Ray obstruction across boards", "origin": "proposed_resolution", "path": "movement.ray_intermediate_blockers", "rationale": "Any piece on any board blocks an intermediate projected coordinate. Pieces on other boards at the source coordinate are ignored, endpoint occupancy is checked only on the chosen destination square, and rays may pass coordinates with no physical square but cannot end there."},
    {"id": "D08", "topic": "Zero projected displacement", "origin": "proposed_resolution", "path": "movement.zero_projected_displacement", "rationale": "Moving to the same projected file and rank on another board is not a move. Two kings at the same projected coordinate on different boards therefore do not attack each other."},
    {"id": "D09", "topic": "Pawn double step", "origin": "proposed_resolution", "path": "movement.pawn_double_step", "rationale": "An unmoved pawn may advance two ranks if no piece on any board stands on the crossed coordinate and the chosen destination square is empty. Transport by a platform consumes this right."},
    {"id": "D10", "topic": "Transport consumes rights", "origin": "proposed_resolution", "path": "platform_actions", "rationale": "Moving a platform marks its carried piece as moved, removes castling rights tied to a carried king or rook, and resets the 100-ply counter when it carries a pawn. Returning the platform never restores a right."},
    {"id": "D11", "topic": "Promotion endpoints", "origin": "proposed_resolution", "path": "promotion", "rationale": "White promotes on arrival at rank 8 of B, or rank 9 of a platform docked at a B high dock; Black on rank 1 of W or rank 0 of a platform at a W low dock. Promotion is part of the arriving action, including a platform action, and never happens passively when some other platform moves."},
    {"id": "D12", "topic": "En passant", "origin": "proposed_resolution", "path": "en_passant", "rationale": "Only an individual pawn double step creates the right. The capturing pawn lands on any empty square at the crossed coordinate and removes the recorded victim. The right lapses after the next action."},
    {"id": "D13", "topic": "Castling", "origin": "proposed_resolution", "path": "castling", "rationale": "Castling is a compound action needing the original king and rook on their home squares and home docks, unspent rights and one completed earlier turn. King side swaps king and rook on the king platform; queen side moves the king to b0/b9 and the rook to e0/e9."},
    {"id": "D14", "topic": "Queen-side castling safety", "origin": "proposed_resolution", "path": "castling.white.queenside", "rationale": "No piece on any board may stand on the projected d and c coordinates of the home rank. The king's source must be safe, and d, c and b are probed for attacks with the king lifted from its source, even where no physical square exists."},
    {"id": "D15", "topic": "Check and king capture", "origin": "proposed_resolution", "path": "check", "rationale": "Attacks are geometric threats, not recursively legal moves. A platform carrying a king may leave check if the final position is safe; travel through intermediate docks has no meaning. Kings are never captured."},
    {"id": "D16", "topic": "Automatic draws", "origin": "proposed_resolution", "path": "draws", "rationale": "Third repetition, 100 plies without capture or pawn action (pawn transport counts) and bare kings are automatic draws. Orthodox insufficient-material tables are not used. A computational cutoff is a truncation, never a draw."},
    {"id": "D17", "topic": "Terminal precedence", "origin": "proposed_resolution", "path": "terminal_precedence", "rationale": "After a legal action the result is decided in this order: checkmate, stalemate, repetition, halfmove limit, bare kings."},
    {"id": "D18", "topic": "Repetition identity", "origin": "proposed_resolution", "path": "repetition_key", "rationale": "Positions repeat when side, square occupancy by type and colour, platform docks and orientations, castling rights, first-turn eligibility while it matters, pawn double-step rights and an en-passant right that can actually be used are equal. Piece ids, ply and clocks are excluded."}
  ]
}
